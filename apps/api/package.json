{
  "name": "@rulekit/api",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "worker": "node dist/worker.js",
    "test": "npm run build && node --test dist/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "8.2.0",
    "@fastify/cors": "8.2.0",
    "@fastify/jwt": "8.0.1",
    "@prisma/client": "5.22.0",
    "@rulekit/engine": "0.1.0",
    "bcryptjs": "2.4.3",
    "bullmq": "2.4.0",
    "dotenv": "16.0.3",
    "ioredis": "5.2.4",
    "lru-cache": "7.14.1",
    "openai": "4.26.0",
    "pdf-parse": "1.1.1",
    "pino": "8.7.0",
    "fastify": "4.9.2",
    "zod": "3.19.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.2",
    "@types/node": "22.19.15",
    "@types/pdf-parse": "1.1.4",
    "prisma": "5.22.0"
  }
}
