generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  editor
  viewer
}

enum Outcome {
  allow
  deny
  review
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  memberships  Membership[]
  reviews      ReviewTask[]
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  memberships Membership[]
  projects    Project[]
  apiKeys     ApiKey[]
}

model Membership {
  userId      String
  workspaceId String
  role        Role
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Project {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  createdAt       DateTime         @default(now())
  activeVersionId String?          @unique
  activeVersion   RulesetVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        RulesetVersion[] @relation("ProjectVersions")
  draft           Draft?
  evaluations     EvaluationLog[]

  @@unique([workspaceId, slug])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  hash        String    @unique
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model Draft {
  projectId  String   @id
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ruleset    Json
  updatedAt  DateTime @updatedAt
}

model RulesetVersion {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  activeFor   Project?        @relation("ActiveVersion")
  number      Int
  checksum    String
  ruleset     Json
  note        String?
  createdAt   DateTime        @default(now())
  evaluations EvaluationLog[]

  @@unique([projectId, number])
}

model EvaluationLog {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId      String
  version        RulesetVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  versionNumber  Int
  input          Json
  outputs        Json
  matchedRuleIds String[]
  outcome        Outcome
  durationUs     Int
  trace          Json
  createdAt      DateTime       @default(now())
  review         ReviewTask?

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
}

model ReviewTask {
  id           String       @id @default(cuid())
  evaluationId String      @unique
  evaluation   EvaluationLog @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  status       ReviewStatus @default(pending)
  reviewerId   String?
  reviewer     User?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
}
